{
  "name": "music-search-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.9",
    "expo-audio": "~57.0.3",
    "expo-blur": "~57.0.2",
    "expo-dev-client": "~57.0.10",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-system-ui": "~57.0.2",
    "expo-video": "~57.0.2",
    "lucide-react-native": "^1.28.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "netlify dev --command \"expo start --web --port 8081\" --target-port 8081 --port 8888",
    "web:expo": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint --max-warnings 0",
    "test": "vitest run",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "verify:production": "npm run typecheck && npm run lint && npm run test && npm run audit:production && npm run build:web && node scripts/verify-production.mjs"
  },
  "private": true
}
